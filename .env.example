# Copy to .env (or .env.local) and adjust.

# Where the website sends API requests.
#   Development: leave as /api - the Vite dev server proxies /api to BACKEND_URL below.
#   Production:  the backend's public URL, e.g. https://api.gee-assist.example.com
#                (and add the website's origin to CORS_ORIGINS in the backend's .env)
VITE_API_BASE_URL=/api

# Backend the dev-server proxy forwards to (development only).
BACKEND_URL=http://localhost:8000

# Where the "Download for Windows" buttons point. Leave empty to link to the GitHub releases page.
VITE_DOWNLOAD_URL=
VITE_GITHUB_URL=https://github.com/Abdullah2265Habib/GEE-Assist
